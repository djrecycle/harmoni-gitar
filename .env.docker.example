# Dipakai dengan:  docker compose --env-file .env.docker up -d --build
# Salin ke .env.docker lalu isi.

# ---- Wajib ----
POSTGRES_PASSWORD=ganti-dengan-kata-sandi-kuat
# openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Alamat yang dibuka di browser. Untuk HP di Wi-Fi yang sama: http://<IP-komputer-guru>:3001
# Di VPS: https://harmoniclass.tech
BETTER_AUTH_URL=http://localhost:3001

# ---- Opsional ----
APP_PORT=3001
DB_PORT=5433
