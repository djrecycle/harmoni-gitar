# Untuk `npm run dev` di komputer sendiri. Salin ke .env.local lalu isi.

# ---- Wajib ----
# Kunci rahasia untuk menandatangani sesi (minimal 32 karakter). Buat dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Alamat aplikasi tanpa garis miring di akhir. Link undangan juga memakai alamat ini.
BETTER_AUTH_URL=http://localhost:3001

# ---- Database ----
# PostgreSQL dari `docker compose --env-file .env.docker up -d db` (port 5433).
# Kata sandi = POSTGRES_PASSWORD di .env.docker.
DATABASE_URL=postgres://harmoni-gitar:ganti-kata-sandi@127.0.0.1:5433/harmoni_gitar

# ---- Penyimpanan file ----
# "local" (bawaan, disimpan di ./uploads) atau "s3" (S3-compatible: AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_DRIVER=local
UPLOAD_DIR=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---- Akun guru pertama (opsional) ----
# Dipakai `npm run setup:teacher` bila argumen --name/--email/--password tidak diberikan.
TEACHER_NAME=
TEACHER_EMAIL=
TEACHER_USERNAME=
TEACHER_PASSWORD=
